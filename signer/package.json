{
  "name": "@opencredential/signer",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCredential signer: the only process that handles issuer private keys (ADR-0003)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.build.json && node dist/server.js",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@digitalbazaar/credentials-context": "3.2.0",
    "@digitalbazaar/data-integrity": "2.5.0",
    "@digitalbazaar/data-integrity-context": "2.0.1",
    "@digitalbazaar/did-method-key": "5.3.0",
    "@digitalbazaar/ed25519-multikey": "1.3.1",
    "@digitalbazaar/eddsa-rdfc-2022-cryptosuite": "1.3.0",
    "@digitalbazaar/multikey-context": "2.0.1",
    "@digitalbazaar/vc": "7.3.0",
    "@digitalcredentials/open-badges-context": "3.0.0",
    "base58-universal": "2.0.0",
    "fastify": "5.12.8",
    "jsonld": "9.0.0",
    "jsonld-signatures": "11.6.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
