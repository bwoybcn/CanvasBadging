# Reverse proxy for docker/compose.production.yaml. The nginx image fills in ${OC_HOSTNAME} and
# ${OC_PROXY_RATE} when it starts; every other $name here is nginx's own.
#
# Rate limits are per client address. A whole campus can share one address, so the general
# allowance is generous (OC_PROXY_RATE, 50 requests a second with a burst of 300). The routes
# that check a badge without signing in cost far more each, and get a tighter one.

limit_req_zone $binary_remote_addr zone=oc_general:20m rate=${OC_PROXY_RATE};
limit_req_zone $binary_remote_addr zone=oc_verify:20m rate=2r/s;
limit_req_status 429;

server {
    listen 80;
    server_name ${OC_HOSTNAME};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${OC_HOSTNAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:oc_tls:10m;
    server_tokens       off;

    # Badge artwork is the largest upload (sent base64-encoded inside JSON).
    client_max_body_size 8m;

    # The app sets its own security headers. Do NOT add X-Frame-Options here: Canvas shows
    # the tool in a frame.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    # Replace, never append: the api believes this header, so it must be the address nginx saw.
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;

    location = /api/v1/verify {
        limit_req zone=oc_verify burst=30 nodelay;
        proxy_pass http://api:8000;
    }

    # A shared badge page, /verify/<id>. (A plain "location /verify/" would make nginx redirect
    # the checker page at /verify to /verify/, which does not exist.)
    location ~ ^/verify/. {
        limit_req zone=oc_verify burst=30 nodelay;
        proxy_pass http://api:8000;
    }

    location / {
        limit_req zone=oc_general burst=300 nodelay;
        proxy_pass http://api:8000;
    }
}
