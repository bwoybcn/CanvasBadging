# Settings for docker/compose.production.yaml. Copy to docker/production.env (which Git
# ignores), fill in EVERY empty value, and keep the file readable by the deploying account only:
#
#   cp docker/production.env.example docker/production.env && chmod 600 docker/production.env
#
# Generate each secret separately. Never reuse one, and never use a value from this repository:
# the services refuse the development values.
#
#   openssl rand -hex 32        for the passwords and keys marked "hex"
#   openssl rand -base64 32     for SIGNER_KEK only

# The release to run, exactly as tagged, for example 1.0.0 (see the repository's Releases page).
OC_VERSION=

# The public name of this service, without https://. Canvas, students and anyone checking a
# badge all use it. It must match the certificate in docker/certs.
OC_HOSTNAME=

# --- Database passwords (hex). Used once to create the roles, then by the services. ---------
POSTGRES_PASSWORD=
OC_OWNER_PASSWORD=
OC_APP_PASSWORD=
OC_SIGNER_PASSWORD=

# --- Application secrets (hex) ---------------------------------------------------------------
# Signs session tokens.
OC_SECRET_KEY=
# Shared by the api, the worker and the signer so the signer knows who is calling.
OC_SIGNER_SHARED_SECRET=
# Encrypts the Canvas access tokens stored in the database.
OC_TOKEN_ENCRYPTION_KEY=

# --- The key that protects every signing key (base64, 32 bytes) -----------------------------
# Only the signer gets this. LOSING IT MEANS LOSING EVERY SIGNING KEY: keep an offline copy
# under the same care as a root certificate key, separately from the database backups.
SIGNER_KEK=

# --- Optional ----------------------------------------------------------------------------------
# Chat channel told when background jobs fail. "text" suits Slack-style incoming webhooks,
# "teams" a Microsoft Teams workflow webhook.
OC_ALERT_WEBHOOK_URL=
OC_ALERT_WEBHOOK_FORMAT=text
# API processes. Roughly one for each CPU core you can spare.
OC_API_WORKERS=4
# Requests a second one client address may make through the proxy (burst of 300 on top).
OC_PROXY_RATE=50r/s
# Folder holding fullchain.pem and privkey.pem (default docker/certs).
# OC_TLS_DIR=/etc/ssl/opencredential
