# Copy to .env for local overrides. Everything here is for DEVELOPMENT.
# Production must set its own secrets; the api and signer refuse to start with these values.

OC_ENV=development
OC_DATABASE_URL=postgresql+psycopg://oc_app:oc_app_dev@localhost:5432/opencredential
OC_DATABASE_OWNER_URL=postgresql+psycopg://oc_owner:oc_owner_dev@localhost:5432/opencredential
OC_SIGNER_URL=http://localhost:8790
OC_PUBLIC_BASE_URL=http://localhost:8000
# OC_SECRET_KEY=            # >= 32 random chars in production (session token signing)
# OC_SIGNER_SHARED_SECRET=  # api <-> signer bearer secret in production
# OC_VERIFICATION_HOST=     # decided later; placeholder credentials.example.ac.uk until then
OC_LOG_JSON=false

# Signer
SIGNER_DATABASE_URL=postgresql://oc_signer:oc_signer_dev@localhost:5432/opencredential
# SIGNER_KEK=               # 32 random bytes, base64. Unset = committed DEV KEK (refused in production)
